NODE_ENV=development

# Database configuration for development environment
DATABASE_HOST_DEV=127.0.0.1
DATABASE_USERNAME_DEV=root
DATABASE_PASSWORD_DEV=
DATABASE_NAME_DEV=learn
PORT=0131
ACCESS_TOKEN_SECRET="ranjan",
REFRESH_TOKEN_SECRET="ranjan",
ACCESS_TOKEN_EXPIRY="10 hours"
REFRESH_TOKEN_EXPIRY="30 days"
APP_NAME="testing"

# Database configuration for production environment
DATABASE_HOST_PROD=your_production_host
DATABASE_USERNAME_PROD=your_production_username
DATABASE_PASSWORD_PROD=your_production_password
DATABASE_NAME_PROD=your_production_database_name

CORS_URLS="http://localhost:3000"

DATABASE_URL="mysql://root:@127.0.0.1:3306/learn"
# MySQL server used to create one database per client (host may include a port: 127.0.0.1:3306)
DB_HOST=
DB_USER=
DB_PASS=
# only used by prisma when migrating a tenant database; the app fills it in per client
NEW_DATABASE_URL=

# link used in password-reset emails, e.g. https://app.yourdomain.com
APP_URL=
# set to 1 when running behind nginx or a load balancer
TRUST_PROXY=
# Outgoing email (password reset and guest emails). Pick ONE of these two ways. Leave both empty in development:
# the email is then printed in the server log.
#
# 1) Gmail. Turn on 2-Step Verification, then create an App password:
#    Google account -> Security -> 2-Step Verification -> App passwords. Paste the 16 characters below.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 2) Any other mail service (Amazon SES, Brevo, Zoho...)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender shown to guests, e.g. YHM <youraddress@gmail.com>. Gmail always sends from the signed-in account.
MAIL_FROM=
